{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kurogane",
  "version": "0.1.0",
  "identifier": "dev.kurogane.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../ui",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../ui"
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Kurogane",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#eeece7",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage"
    ],
    "publisher": "Issen Software Group",
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "legal/LICENSE",
      "../NOTICE": "legal/NOTICE",
      "../THIRD_PARTY_NOTICES.md": "legal/THIRD_PARTY_NOTICES.md",
      "../THIRD_PARTY_LICENSES.txt": "legal/THIRD_PARTY_LICENSES.txt",
      "../docs/LICENSING.md": "legal/LICENSING.md",
      "../docs/legal/rclone-COPYING": "legal/rclone-COPYING",
      "../docs/legal/appimage-NOTICES.txt": "legal/appimage-NOTICES.txt",
      "legal-platform/": "legal/platform/"
    },
    "copyright": "Copyright © 2026 Issen Software Group and Kurogane contributors",
    "category": "DeveloperTool",
    "shortDescription": "Map your infrastructure and keep its passwords in one encrypted vault",
    "longDescription": "Kurogane maps every company's machines, services, proxies and domains as an automatic isometric diagram, keeps the accounts for each of them in an encrypted vault, and opens websites, SSH and RDP sessions in one click.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "kurogane"
        ],
        "name": "Kurogane vault",
        "description": "Kurogane encrypted vault",
        "role": "Editor",
        "mimeType": "application/x-kurogane"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Kurogane"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 190
        }
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "desktopTemplate": "linux/kurogane.desktop"
      }
    }
  }
}
